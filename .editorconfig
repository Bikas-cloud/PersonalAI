
root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.cs]
indent_size = 4

[*.{json,yml,yaml,md}]
indent_size = 2

[*.cshtml]
indent_size = 4

[*.{js,css,html}]
indent_size = 2

[*.{slnx,csproj,props,targets}]
indent_size = 2